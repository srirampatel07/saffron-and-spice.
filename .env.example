# Copy this file to .env and fill in values.
# The app runs without Razorpay keys: online payment is disabled, Cash on Delivery works.
PORT=5000
CLIENT_URL=http://localhost:5173

# Optional extra exact CORS origins, comma-separated. CLIENT_URL is always allowed.
# Add the current public Vite tunnel origin here; update it when the tunnel changes.
# Example: CLIENT_ORIGINS=https://your-tunnel.trycloudflare.com
CLIENT_ORIGINS=

# Public origin used for canonical URLs, Open Graph tags, sitemap.xml and robots.txt.
# Set this to the real HTTPS origin before building for production.
SITE_URL=http://localhost:5173

# Razorpay TEST keys only (dashboard.razorpay.com → Settings → API Keys → Test mode).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Webhook secret you choose in the Razorpay dashboard (test mode webhooks).
RAZORPAY_WEBHOOK_SECRET=

# Basic admin password for the demo dashboard. Use a long random value.
ADMIN_PASSWORD=

# Separate random secret used to sign admin session tokens.
# Production refuses to start without a value of at least 32 characters.
ADMIN_TOKEN_SECRET=

# Optional: let the API serve the built client from client/dist with the same
# security headers. Leave false when a separate static host is used.
SERVE_CLIENT=false

# Optional. Defaults to server/data/saffron-spice.db
# DB_PATH=
